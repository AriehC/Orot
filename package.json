{
  "name": "orot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "set -a && . ./.env.emulators && set +a && next dev --port 3001",
    "emulators": "firebase emulators:start --project demo-orot --only auth,firestore,storage",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "seed:emulators": "set -a && . ./.env.emulators && set +a && tsx scripts/seed.ts",
    "test:rules": "tsx scripts/test-rules.ts"
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-masonry-css": "^1.0.16"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": "22"
  }
}
