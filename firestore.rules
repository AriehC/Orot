rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions ---
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function incomingData() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    function isValidString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // Only these fields changed
    function onlyChanged(fields) {
      return incomingData().diff(existingData()).affectedKeys().hasOnly(fields);
    }

    // Counters are denormalized and bumped from the client, one step at a time
    function stepOk(field) {
      return math.abs(incomingData().get(field, 0) - existingData().get(field, 0)) <= 1;
    }

    function isPostAuthor(postId) {
      return isAuth()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    function isBoardOwner(boardId) {
      return isAuth()
        && get(/databases/$(database)/documents/boards/$(boardId)).data.ownerId == request.auth.uid;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if true;
      // Email lives only in Firebase Auth — never in the public profile
      allow create: if isOwner(userId)
        && !('email' in incomingData())
        && isValidString(incomingData().displayName, 50)
        && incomingData().followerCount == 0
        && incomingData().followingCount == 0;
      allow update: if (
        // Owner edits their profile — but not the social counters
        isOwner(userId)
          && !('email' in incomingData())
          && isValidString(incomingData().displayName, 50)
          && (!('bio' in incomingData()) || isValidString(incomingData().bio, 500))
          && incomingData().followerCount == existingData().followerCount
          && incomingData().followingCount == existingData().followingCount
      ) || (
        // Follow / unfollow: either side's counter moves by one, nothing else changes
        isAuth()
          && onlyChanged(['followerCount', 'followingCount'])
          && stepOk('followerCount')
          && stepOk('followingCount')
      );
      allow delete: if isOwner(userId);
    }

    // --- Posts ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuth()
        && incomingData().authorId == request.auth.uid
        && isValidString(incomingData().title, 200)
        && (!('body' in incomingData()) || isValidString(incomingData().body, 5000))
        && incomingData().type in ['note', 'quote', 'image', 'video']
        && (!('links' in incomingData()) || (incomingData().links is list && incomingData().links.size() <= 50))
        && incomingData().likeCount == 0
        && incomingData().saveCount == 0
        && incomingData().boardCount == 0;
      allow delete: if isOwner(existingData().authorId);
      // Author can update anything; others can only update counters
      allow update: if isAuth() && (
        isOwner(existingData().authorId)
          && incomingData().authorId == existingData().authorId
        ||
        onlyChanged(['likeCount', 'saveCount', 'boardCount', 'commentCount'])
          && stepOk('likeCount') && stepOk('saveCount')
          && stepOk('boardCount') && stepOk('commentCount')
      );
    }

    // --- Likes ---
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuth()
        && incomingData().userId == request.auth.uid;
      // The post's author may clear likes when deleting the post
      allow delete: if isOwner(existingData().userId)
        || isPostAuthor(existingData().postId);
    }

    // --- Saves ---
    match /saves/{saveId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && incomingData().userId == request.auth.uid;
      allow delete: if isOwner(existingData().userId)
        || isPostAuthor(existingData().postId);
    }

    // --- Boards ---
    match /boards/{boardId} {
      allow read: if existingData().isPublic == true
        || isOwner(existingData().ownerId);
      allow create: if isAuth()
        && incomingData().ownerId == request.auth.uid
        && isValidString(incomingData().name, 100)
        && (!('description' in incomingData()) || isValidString(incomingData().description, 500))
        && incomingData().likeCount == 0
        && incomingData().followerCount == 0;
      allow update: if (
        isOwner(existingData().ownerId)
          && incomingData().ownerId == existingData().ownerId
      ) || (
        // Likes, follows, and a post being removed from the board by its author
        isAuth()
          && onlyChanged(['likeCount', 'followerCount', 'itemCount'])
          && stepOk('likeCount') && stepOk('followerCount') && stepOk('itemCount')
      );
      allow delete: if isOwner(existingData().ownerId);
    }

    // --- Board Items ---
    match /boardItems/{itemId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && incomingData().addedBy == request.auth.uid
        && isBoardOwner(incomingData().boardId);
      allow delete: if isOwner(existingData().addedBy)
        || isBoardOwner(existingData().boardId)
        || isPostAuthor(existingData().postId);
    }

    // --- Board Likes ---
    match /boardLikes/{likeId} {
      allow read: if true;
      allow create: if isAuth()
        && incomingData().userId == request.auth.uid;
      allow delete: if isOwner(existingData().userId)
        || isBoardOwner(existingData().boardId);
    }

    // --- Board Follows ---
    match /boardFollows/{followId} {
      allow read: if true;
      allow create: if isAuth()
        && incomingData().userId == request.auth.uid;
      allow delete: if isOwner(existingData().userId)
        || isBoardOwner(existingData().boardId);
    }

    // --- User Follows ---
    match /userFollows/{followId} {
      allow read: if true;
      // Field names match the app: followerId follows followingId
      allow create: if isAuth()
        && incomingData().followerId == request.auth.uid
        && incomingData().followingId is string
        && incomingData().followingId != request.auth.uid;
      // Either side may remove the relationship (unfollow, or account deletion)
      allow delete: if isOwner(existingData().followerId)
        || isOwner(existingData().followingId);
    }

    // --- Comments (public, like posts) ---
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuth()
        && incomingData().authorId == request.auth.uid
        && incomingData().postId is string
        && isValidString(incomingData().body, 1000);
      // The post's author may remove comments on their post
      allow delete: if isOwner(existingData().authorId)
        || isPostAuthor(existingData().postId);
    }

    // --- Notifications (private to the recipient) ---
    match /notifications/{notificationId} {
      allow read: if isOwner(existingData().recipientId);
      allow create: if isAuth()
        && incomingData().actorId == request.auth.uid
        && incomingData().recipientId != request.auth.uid
        && incomingData().read == false;
      allow update: if isOwner(existingData().recipientId)
        && onlyChanged(['read']);
      allow delete: if isOwner(existingData().recipientId);
    }

    // Tags double as shared concept pages (wiki): any signed-in user may edit
    function isValidConcept() {
      return isValidString(incomingData().name, 60)
        && (!('description' in incomingData()) || isValidString(incomingData().description, 3000))
        && (!('aliases' in incomingData()) || (incomingData().aliases is list && incomingData().aliases.size() <= 10))
        && (!('related' in incomingData()) || (incomingData().related is list && incomingData().related.size() <= 15))
        && (!('links' in incomingData()) || (incomingData().links is list && incomingData().links.size() <= 50));
    }

    match /tags/{tagName} {
      allow read: if true;
      allow create: if isAuth()
        && isValidConcept()
        && (!('updatedBy' in incomingData()) || incomingData().updatedBy == request.auth.uid);
      allow update: if isAuth()
        && isValidConcept()
        // Editor attribution can only be set to yourself
        && (!incomingData().diff(existingData()).affectedKeys().hasAny(['updatedBy'])
            || incomingData().updatedBy == request.auth.uid);
    }
  }
}
