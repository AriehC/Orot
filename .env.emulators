# Used by `npm run dev:emulators` — points the app at local Firebase emulators.
# The demo- project id guarantees nothing ever reaches the real project.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-orot.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-orot
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-orot.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
FIREBASE_PROJECT_ID=demo-orot
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Emulator-only test account used for manual UI checks (exists only in the local emulator):
#   email: tester@example.test   password: test-pass-123
